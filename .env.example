# Firebase Web App configuration
# Copy this file to .env.local and fill in your project's values.
# These are public web config values (safe to commit to .env.example).
# Never commit .env.local — it is already in .gitignore.
#
# Deploy Firestore security rules:
#   firebase deploy --only firestore:rules --project aconcagua-co

PUBLIC_FIREBASE_API_KEY=AIzaSyExample-replace-with-your-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=aconcagua-co.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=aconcagua-co
PUBLIC_FIREBASE_STORAGE_BUCKET=aconcagua-co.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:replace-with-your-app-id
# Optional — only needed if you enable Google Analytics
PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
