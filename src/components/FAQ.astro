---
interface Props {
  lang: 'es' | 'en' | 'zh';
  t: (key: string) => string;
}

const { t } = Astro.props;

const categories = [
  {
    key: 'general',
    title: t('faq.category.general.title'),
    items: [
      { id: 'best-season',       q: t('faq.qa.best-season.q'),       a: t('faq.qa.best-season.a') },
      { id: 'duration',          q: t('faq.qa.duration.q'),          a: t('faq.qa.duration.a') },
      { id: 'min-time',          q: t('faq.qa.min-time.q'),          a: t('faq.qa.min-time.a') },
      { id: 'success-rate',      q: t('faq.qa.success-rate.q'),      a: t('faq.qa.success-rate.a') },
      { id: 'mules-porters',     q: t('faq.qa.mules-porters.q'),     a: t('faq.qa.mules-porters.a') },
      { id: 'abandon-expedition',q: t('faq.qa.abandon-expedition.q'),a: t('faq.qa.abandon-expedition.a') },
    ],
  },
  {
    key: 'permits',
    title: t('faq.category.permits.title'),
    items: [
      { id: 'permit-cost',   q: t('faq.qa.permit-cost.q'),   a: t('faq.qa.permit-cost.a') },
      { id: 'guide-required',q: t('faq.qa.guide-required.q'),a: t('faq.qa.guide-required.a') },
      { id: 'minors',        q: t('faq.qa.minors.q'),        a: t('faq.qa.minors.a') },
      { id: 'insurance',     q: t('faq.qa.insurance.q'),     a: t('faq.qa.insurance.a') },
    ],
  },
  {
    key: 'preparation',
    title: t('faq.category.preparation.title'),
    items: [
      { id: 'boots',               q: t('faq.qa.boots.q'),               a: t('faq.qa.boots.a') },
      { id: 'climbing-experience', q: t('faq.qa.climbing-experience.q'), a: t('faq.qa.climbing-experience.a') },
      { id: 'training',            q: t('faq.qa.training.q'),            a: t('faq.qa.training.a') },
    ],
  },
  {
    key: 'health',
    title: t('faq.category.health.title'),
    items: [
      { id: 'medical-service',  q: t('faq.qa.medical-service.q'),  a: t('faq.qa.medical-service.a') },
      { id: 'altitude-sickness',q: t('faq.qa.altitude-sickness.q'),a: t('faq.qa.altitude-sickness.a') },
      { id: 'communication',    q: t('faq.qa.communication.q'),    a: t('faq.qa.communication.a') },
    ],
  },
  {
    key: 'investment',
    title: t('faq.category.investment.title'),
    items: [
      { id: 'total-cost',            q: t('faq.qa.total-cost.q'),            a: t('faq.qa.total-cost.a') },
      { id: 'recognize-local-company',q: t('faq.qa.recognize-local-company.q'),a: t('faq.qa.recognize-local-company.a') },
    ],
  },
];

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: categories.flatMap(c =>
    c.items.map(item => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a.split('\n\n').join(' '),
      },
    }))
  ),
};
---

<section id="faq" class="faq section-pad">
  <div class="container">
    <header class="faq-header reveal">
      <p class="tag">{t('faq.tag')}</p>
      <h2>{t('faq.title')}</h2>
      <p class="faq-subtitle">{t('faq.subtitle')}</p>
    </header>

    <div class="faq-categories">
      {categories.map(cat => (
        <div class="faq-category reveal">
          <h3 class="faq-category-title">{cat.title}</h3>
          <ul class="faq-list" role="list">
            {cat.items.map(item => (
              <li class="faq-item">
                <details class="faq-details">
                  <summary class="faq-question">
                    <span>{item.q}</span>
                    <svg
                      class="faq-chevron"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </summary>
                  <div class="faq-answer">
                    {item.a.split('\n\n').map(p => (
                      <p>{p}</p>
                    ))}
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

<style>
  .faq {
    background: var(--section-faq-bg);
    scroll-margin-top: 80px;
  }

  .faq-header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .faq-header h2 {
    font-size: var(--fs-h1);
    color: var(--text-primary);
    margin-top: 4px;
    margin-bottom: 16px;
  }

  .faq-subtitle {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ─── Categories layout ────────────────────────────── */

  .faq-categories {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
    max-width: 800px;
    margin-inline: auto;
  }

  .faq-category {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .faq-category-title {
    font-size: var(--fs-h3);
    color: var(--accent);
    padding: 20px 24px 12px;
    border-bottom: 1px solid var(--border-card);
  }

  /* ─── List & items ─────────────────────────────────── */

  .faq-list {
    list-style: none;
  }

  .faq-item {
    border-bottom: 1px solid var(--border-card);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  /* ─── Details / Summary ─────────────────────────────── */

  .faq-details {
    width: 100%;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 24px;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  /* Remove native marker in all browsers */
  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--accent);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: var(--radius-md);
  }

  .faq-question span {
    flex: 1;
    line-height: 1.5;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--accent);
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-chevron {
      transition: transform 0.25s ease;
    }

    .faq-details[open] .faq-chevron {
      transform: rotate(180deg);
    }
  }

  /* ─── Answer ────────────────────────────────────────── */

  .faq-answer {
    padding: 0 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-answer p {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ─── Responsive ────────────────────────────────────── */

  @media (max-width: 600px) {
    .faq-question {
      padding: 16px 18px;
    }

    .faq-answer {
      padding: 0 18px 18px;
    }

    .faq-category-title {
      padding: 16px 18px 10px;
    }
  }
</style>
