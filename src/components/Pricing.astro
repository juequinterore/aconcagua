---
import PricingCard from './PricingCard.astro';
import { packages } from '@/data/packages';
import { getPackageUrl } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en' | 'zh';
  t: (key: string) => string;
}

const { lang, t } = Astro.props;

const cards = packages.map(p => ({
  name: t(p.nameKey),
  price: t(p.priceKey),
  features: p.featureKeys.map(k => t(k)),
  cta: t('pricing.view_details'),
  featured: p.featured,
  badge: p.badgeKey ? t(p.badgeKey) : undefined,
  href: getPackageUrl(lang, p.id),
}));
---

<section id="expediciones" class="pricing section-pad">
  <div class="container">
    <div class="pricing-header reveal">
      <p class="tag">{t('pricing.tag')}</p>
      <h2>{t('pricing.title')}</h2>
      <p class="pricing-subtitle">{t('pricing.subtitle')}</p>
    </div>

    <div class="pricing-grid">
      {cards.map((card, i) => (
        <div id={`plan-${i + 1}`} class="reveal plan-anchor" style={`transition-delay: ${i * 0.12}s`}>
          <PricingCard
            name={card.name}
            price={card.price}
            features={card.features}
            cta={card.cta}
            featured={card.featured}
            badge={card.badge}
            href={card.href}
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--section-pricing-bg);
  }

  .plan-anchor {
    scroll-margin-top: 90px;
  }

  .pricing-header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .pricing-header h2 {
    font-size: var(--fs-h1);
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .pricing-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-grid);
    align-items: center;
    padding-block: 20px;
  }

  @media (max-width: 1200px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-inline: auto;
    }
  }

</style>
