---
import PricingContactForm from './PricingContactForm.astro';

interface Props {
  name: string;
  price: string;
  features: string[];
  cta: string;
  featured?: boolean;
  badge?: string;
  calendlyUrl: string;
  packageId: 'card1' | 'card2' | 'card3' | 'card4';
  packageSlug: string;
  lang: 'es' | 'en' | 'zh';
  t: (key: string) => string;
}

const { name, price, features, cta, featured = false, badge, calendlyUrl, packageId, packageSlug, lang, t } = Astro.props;

const dialogId = `pcf-${packageSlug}`;
---

<div class:list={['pricing-card', { featured }]}>
  {badge && <div class="pricing-badge">{badge}</div>}

  <div class="pricing-card-header">
    <h3 class="pricing-name">{name}</h3>
    <div class="pricing-price">{price}</div>
  </div>

  <ul class="feature-list" role="list">
    {features.map(feature => (
      <li>{feature}</li>
    ))}
  </ul>

  <button
    type="button"
    class:list={['btn', featured ? 'btn-primary' : 'btn-outline', 'pricing-cta']}
    data-pricing-cta-trigger={dialogId}
  >
    {cta}
  </button>

  <PricingContactForm
    lang={lang}
    t={t}
    packageId={packageId}
    packageSlug={packageSlug}
    packageName={name}
    packagePrice={price}
    dialogId={dialogId}
  />

  <button
    type="button"
    class="btn btn-outline schedule-call-btn"
    onclick={`Calendly.initPopupWidget({url: '${calendlyUrl}'}); return false;`}
  >
    {t('pricing.contact.cta')}
  </button>
</div>

<style>
  .pricing-card {
    position: relative;
    background: var(--bg-card);
    border: 1.5px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: var(--card-pad);
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .pricing-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-4px);
  }

  .pricing-card.featured {
    border: 2px solid var(--accent);
    transform: scale(1.04);
    box-shadow: var(--shadow-gold);
    background: var(--bg-card);
    z-index: 2;
  }

  .pricing-card.featured:hover {
    transform: scale(1.04) translateY(-4px);
    box-shadow: 0 16px 48px rgba(200, 138, 62, 0.35);
  }

  .pricing-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 16px;
    border-radius: 20px;
    white-space: nowrap;
    box-shadow: var(--shadow-gold);
  }

  .pricing-card-header {
    border-bottom: 1px solid var(--border-card);
    padding-bottom: 20px;
  }

  .pricing-name {
    font-family: 'Inter', sans-serif;
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .pricing-price {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  .featured .pricing-price {
    color: var(--accent);
  }

  .pricing-cta {
    width: 100%;
    justify-content: center;
    padding: 14px 24px;
    margin-top: auto;
  }

  /* Schedule a Call button — secondary / text-link style (visual hierarchy preserved from former .contact-trigger) */
  .schedule-call-btn {
    width: 100%;
    background: none;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: 10px 16px;
    cursor: pointer;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text-secondary);
    text-align: center;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .schedule-call-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: transparent;
  }

  .schedule-call-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-lg);
  }

  @media (max-width: 768px) {
    .pricing-card.featured {
      transform: scale(1);
    }

    .pricing-card.featured:hover {
      transform: translateY(-4px);
    }
  }
</style>
