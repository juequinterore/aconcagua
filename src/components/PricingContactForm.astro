---
interface Props {
  lang: 'es' | 'en' | 'zh';
  t: (k: string) => string;
  packageId: 'card1' | 'card2' | 'card3' | 'card4';
  packageSlug: string;
  packageName: string;
  packagePrice: string;
}

const { lang, t, packageId, packageSlug, packageName, packagePrice } = Astro.props;

const uid = `pcf-${Math.random().toString(36).slice(2, 9)}`;
const dialogId = `${uid}-modal`;
const formId = `${uid}-form`;
const statusId = `${uid}-status`;
const nameId = `${uid}-name`;
const emailId = `${uid}-email`;

const privacyHref = lang === 'es' ? '/privacidad' : `/${lang}/privacy`;
---

<div
  class="pricing-contact-wrapper"
  data-pricing-contact-form
  data-dialog-id={dialogId}
  data-form-id={formId}
  data-msg-sending={t('pricing.contact.sending')}
  data-msg-success={t('pricing.contact.success')}
  data-msg-error={t('pricing.contact.error')}
  data-err-name={t('pricing.contact.error_required_name')}
  data-err-email={t('pricing.contact.error_required_email')}
  data-err-email-format={t('pricing.contact.error_invalid_email')}
>
  <!-- Trigger button -->
  <button
    type="button"
    class="contact-trigger"
    aria-haspopup="dialog"
    aria-controls={dialogId}
  >
    {t('pricing.contact.cta')}
  </button>

  <!-- Per-card contact dialog -->
  <dialog
    class="contact-modal"
    id={dialogId}
    aria-modal="true"
    aria-label={`${t('pricing.contact.modal_title')} ${packageName}`}
  >
    <button class="modal-close" type="button" aria-label={t('pricing.contact.close')}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <h2 class="modal-heading">{t('pricing.contact.modal_title')} — {packageName}</h2>
    <p class="modal-intro">{t('pricing.contact.intro')}</p>

    <form id={formId} class="contact-form" novalidate>
      <!-- Hidden package context fields -->
      <input type="hidden" name="packageId" value={packageId} />
      <input type="hidden" name="packageSlug" value={packageSlug} />
      <input type="hidden" name="packageName" value={packageName} />
      <input type="hidden" name="packagePrice" value={packagePrice} />
      <input type="hidden" name="lang" value={lang} />

      <div class="form-field">
        <label for={nameId}>{t('pricing.contact.field_name')}</label>
        <input
          type="text"
          id={nameId}
          name="name"
          autocomplete="name"
          required
          minlength="2"
          maxlength="120"
          placeholder={t('pricing.contact.field_name_placeholder')}
          aria-required="true"
        />
        <span class="field-error" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for={emailId}>{t('pricing.contact.field_email')}</label>
        <input
          type="email"
          id={emailId}
          name="email"
          autocomplete="email"
          required
          maxlength="254"
          placeholder={t('pricing.contact.field_email_placeholder')}
          aria-required="true"
        />
        <span class="field-error" aria-live="polite"></span>
      </div>

      <button type="submit" class="btn btn-primary submit-btn">
        {t('pricing.contact.submit')}
      </button>
    </form>

    <p id={statusId} class="form-status" role="status" aria-live="polite"></p>

    <p class="privacy-note">
      {t('pricing.contact.privacy_note')}
      {' '}
      <a href={privacyHref} class="privacy-link">{t('footer.privacy')}</a>
    </p>
  </dialog>
</div>

<style>
  .pricing-contact-wrapper {
    margin-top: 8px;
  }

  /* Trigger button — secondary / text-link style */
  .contact-trigger {
    width: 100%;
    background: none;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: 10px 16px;
    cursor: pointer;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text-secondary);
    text-align: center;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .contact-trigger:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: transparent;
  }

  .contact-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-lg);
  }

  /* Modal dialog */
  .contact-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(520px, calc(100vw - 32px));
    max-height: calc(100vh - 64px);
    padding: 36px 32px 32px;
    border: none;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-modal:not([open]) {
    display: none;
  }

  .contact-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  /* Close button */
  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-card);
    background: transparent;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .modal-close:hover {
    background: var(--accent);
    color: var(--white);
    border-color: var(--accent);
  }

  .modal-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Headings and intro */
  .modal-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--fs-h3, 1.25rem);
    color: var(--text-primary);
    padding-right: 40px;
  }

  .modal-intro {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-field input[type="text"],
  .form-field input[type="email"] {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 14px;
    border: 1.5px solid var(--border-card);
    border-radius: var(--radius-lg);
    background: var(--bg-base, var(--bg-card));
    color: var(--text-primary);
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }

  .form-field input[type="text"]:focus,
  .form-field input[type="email"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(200, 138, 62, 0.15);
  }

  .form-field input[type="text"]::placeholder,
  .form-field input[type="email"]::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  .field-error {
    font-size: var(--fs-xs);
    color: var(--accent);
    min-height: 1.2em;
  }

  /* Submit button */
  .submit-btn {
    width: 100%;
    justify-content: center;
    padding: 14px 24px;
    margin-top: 4px;
  }

  .submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  /* Status region */
  .form-status {
    font-size: 0.9375rem;
    line-height: 1.5;
    min-height: 1.5em;
    color: var(--text-secondary);
    text-align: center;
  }

  /* Privacy note */
  .privacy-note {
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    text-align: center;
    margin: 0;
    line-height: 1.5;
  }

  .privacy-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .privacy-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 480px) {
    .contact-modal {
      padding: 28px 20px 24px;
      gap: 16px;
    }
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.querySelectorAll<HTMLElement>('[data-pricing-contact-form]').forEach((wrapper) => {
    const msgSending = wrapper.dataset.msgSending ?? '';
    const msgSuccess = wrapper.dataset.msgSuccess ?? '';
    const msgError = wrapper.dataset.msgError ?? '';
    const errName = wrapper.dataset.errName ?? '';
    const errEmail = wrapper.dataset.errEmail ?? '';
    const errEmailFormat = wrapper.dataset.errEmailFormat ?? '';

    const triggerBtn = wrapper.querySelector<HTMLButtonElement>('.contact-trigger');
    const dialog = wrapper.querySelector<HTMLDialogElement>('.contact-modal');
    const closeBtn = wrapper.querySelector<HTMLButtonElement>('.modal-close');
    const form = wrapper.querySelector<HTMLFormElement>('.contact-form');
    const submitBtn = wrapper.querySelector<HTMLButtonElement>('.submit-btn');
    const statusEl = wrapper.querySelector<HTMLParagraphElement>('.form-status');

    if (!triggerBtn || !dialog || !closeBtn || !form || !submitBtn || !statusEl) return;

    // --- Dialog open/close ---
    triggerBtn.addEventListener('click', () => {
      dialog.showModal();
      const firstInput = form.querySelector<HTMLInputElement>('input[type="text"]');
      firstInput?.focus();
    });

    closeBtn.addEventListener('click', () => {
      dialog.close();
    });

    dialog.addEventListener('click', (e: MouseEvent) => {
      const rect = dialog.getBoundingClientRect();
      const inside =
        e.clientX >= rect.left &&
        e.clientX <= rect.right &&
        e.clientY >= rect.top &&
        e.clientY <= rect.bottom;
      if (!inside) dialog.close();
    });

    // --- Form submission ---
    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      // Clear previous errors/status
      const fieldErrors = form.querySelectorAll<HTMLSpanElement>('.field-error');
      fieldErrors.forEach((el) => { el.textContent = ''; });
      statusEl.textContent = '';

      const nameInput = form.querySelector<HTMLInputElement>('input[name="name"]')!;
      const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      const nameVal = nameInput.value.trim();
      const emailVal = emailInput.value.trim();

      // Client-side validation
      let hasError = false;
      const nameError = nameInput.nextElementSibling as HTMLSpanElement;
      const emailError = emailInput.nextElementSibling as HTMLSpanElement;

      if (!nameVal || nameVal.length < 2) {
        nameError.textContent = errName;
        hasError = true;
      }
      if (!emailVal) {
        emailError.textContent = errEmail;
        hasError = true;
      } else if (!EMAIL_RE.test(emailVal)) {
        emailError.textContent = errEmailFormat;
        hasError = true;
      }
      if (hasError) return;

      // Show sending state
      submitBtn.disabled = true;
      statusEl.textContent = msgSending;

      try {
        // Collect hidden fields
        const packageId = (form.querySelector<HTMLInputElement>('input[name="packageId"]')!).value;
        const packageSlug = (form.querySelector<HTMLInputElement>('input[name="packageSlug"]')!).value;
        const packageName = (form.querySelector<HTMLInputElement>('input[name="packageName"]')!).value;
        const packagePrice = (form.querySelector<HTMLInputElement>('input[name="packagePrice"]')!).value;
        const lang = (form.querySelector<HTMLInputElement>('input[name="lang"]')!).value;

        // Dynamic import to code-split Firebase out of the initial bundle
        const { db } = await import('../lib/firebase');
        const { addDoc, collection, serverTimestamp } = await import('firebase/firestore');

        await addDoc(collection(db, 'contact_form'), {
          name: nameVal,
          email: emailVal,
          packageId,
          packageSlug,
          packageName,
          packagePrice,
          lang,
          pageUrl: window.location.href.slice(0, 2048),
          userAgent: navigator.userAgent.slice(0, 512),
          referrer: document.referrer.slice(0, 2048),
          createdAt: serverTimestamp(),
        });

        statusEl.textContent = msgSuccess;
        form.reset();
      } catch (err) {
        console.error('[PricingContactForm] Firestore write failed:', err);
        statusEl.textContent = msgError;
      } finally {
        submitBtn.disabled = false;
      }
    });
  });
</script>
